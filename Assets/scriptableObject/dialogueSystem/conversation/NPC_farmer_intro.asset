  m_Script: {fileID: 11500000, guid: 18af14bdaf844c441a68207fdd09610b, type: 3}
  m_Name: NPC_farmer_intro
  m_EditorClassIdentifier: Assembly-CSharp::DialogueConversation
  topic: The Keeper of the Field
  lines:
  - character: {fileID: 11400000, guid: 80993e3c86b4337429c2d6273c8eedc2, type: 2}
    portrait: Default
    slot: 1
    text: "Oh — a visitor. I did not expect anyone so soon after the bloom."
    speakerOverride: Field Keeper
    eventId:
    actionGateId:
  - character: {fileID: 11400000, guid: 80993e3c86b4337429c2d6273c8eedc2, type: 2}
    portrait: Default
    slot: 1
    text: This field grew from wishes, you know. Every seed here was someone hoping
      the world would hold together a little longer.
    speakerOverride: Field Keeper
    eventId:
    actionGateId:
  - character: {fileID: 11400000, guid: 80993e3c86b4337429c2d6273c8eedc2, type: 2}
    portrait: Default
    slot: 1
    text: "Stay as long as you like. And if you get restless — my neighbour keeps
      a stacking puzzle just over there. It has eaten entire afternoons of mine."
    speakerOverride: Field Keeper
    eventId:
    actionGateId:
  choices: []
  autoNext: {fileID: 0}
  skippable: 1
