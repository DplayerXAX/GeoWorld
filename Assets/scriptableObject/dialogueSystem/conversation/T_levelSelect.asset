  m_Script: {fileID: 11500000, guid: 18af14bdaf844c441a68207fdd09610b, type: 3}
  m_Name: T_levelSelect
  m_EditorClassIdentifier: Assembly-CSharp::DialogueConversation
  topic: The Overworld
  lines:
  - character: {fileID: 11400000, guid: 80993e3c86b4337429c2d6273c8eedc2, type: 2}
    portrait: Default
    slot: 1
    text: Welcome. Let me show you how to get around this map.
    speakerOverride:
    eventId:
  - character: {fileID: 11400000, guid: 80993e3c86b4337429c2d6273c8eedc2, type: 2}
    portrait: Default
    slot: 1
    text: You start out at your home block. Click any block on the map to walk toward it.
    speakerOverride:
    eventId:
  - character: {fileID: 11400000, guid: 80993e3c86b4337429c2d6273c8eedc2, type: 2}
    portrait: Default
    slot: 1
    text: Each turning cube marks a level. Once a road connects it back to your home block, it lights up and you can play it.
    speakerOverride:
    eventId:
  - character: {fileID: 11400000, guid: 80993e3c86b4337429c2d6273c8eedc2, type: 2}
    portrait: Default
    slot: 1
    text: Right now only this one is connected. Let's walk over and step inside.
    speakerOverride:
    eventId:
  choices: []
  autoNext: {fileID: 0}
  skippable: 1
